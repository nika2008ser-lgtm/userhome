
file="/etc/passwd"

usage() {
    echo "Использование: userhome [-f file] [username]"
    echo "  -f file    указать другой файл"
    echo "  --help     показать справку"
}

while (($#)); do
    case "$1" in
        --help)
            usage
            exit 0
            ;;
        -f)
            if [[ -z "$2" || "$2" == -* ]]; then
                echo "Ошибка: после -f необходимо указать файл" >&2
                usage >&2
                exit 2
            fi
            file="$2"
            shift 2
            ;;
        -*)
            echo "Ошибка: неизвестная опция $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            if [[ -n "$username" ]]; then
                echo "Ошибка: указано несколько имён пользователей" >&2
                usage >&2
                exit 2
            fi
            username="$1"
            shift
            ;;
    esac
done

if [[ -z "$username" ]]; then
    username=$(id -un)
fi

if [[ ! -f "$file" ]]; then
    echo "Ошибка: файл не найден: $file" >&2
    exit 2
fi

line=$(grep -E "^${username}:" "$file")
if [[ -z "$line" ]]; then
    echo "Ошибка: пользователь не найден: $username" >&2
    exit 1
fi

home=$(printf '%s\n' "$line" | cut -d ':' -f 6)

printf '%s\n' "$home"

exit 0
